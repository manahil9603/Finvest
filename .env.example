# Finvest environment variable reference
#
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.

# Database
# Neon example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Local example:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/finvest"
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/finvest"

# Authentication
# Required. Must be at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-cryptographically-random-string-of-at-least-32-chars"

# Application URLs
# Local: http://localhost:3000
# Render: https://your-render-app.onrender.com
NEXTAUTH_URL="http://localhost:3000"

# Email (welcome message on signup — optional in dev, recommended in production)
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# EMAIL_FROM must be quoted when it contains spaces:
# EMAIL_FROM="Finvest <your@gmail.com>"

# Socket.io shares the same HTTP server and port as Next.js.
# Leave this empty locally to use the current origin, or set it to your Render app URL.
NEXT_PUBLIC_SOCKET_URL=""

# Comma-separated list of additional allowed origins for API/socket requests.
# NEXTAUTH_URL is always included.
ALLOWED_ORIGINS=""

# Node/Render
NODE_ENV="development"
PORT="3000"

# Legacy compatibility only. Socket.io now runs on PORT, not on a second port.
SOCKET_PORT="3000"

# Production checklist (Render)
# - Build command: npm run build
# - Start command: node .server/server.js  (do NOT use ts-node in production)
# - JWT_SECRET is at least 48 random hex chars, not the placeholder above.
# - DATABASE_URL points to Neon or another managed PostgreSQL database.
# - NEXTAUTH_URL is your deployed HTTPS URL.
# - NEXT_PUBLIC_SOCKET_URL is empty for same-origin sockets or equals NEXTAUTH_URL.
# - NODE_ENV=production is set by the host.
# - Optional DEBUG_MEMORY=true to log heap usage every 30s.
# - Secrets are stored in your hosting provider, not in source control.
