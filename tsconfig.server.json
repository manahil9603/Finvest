{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./.server",
    "rootDir": "."
  },
  "include": ["server.ts"],
  "exclude": ["node_modules", ".next"]
}
